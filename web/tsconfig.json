{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals", "node"],
    "skipLibCheck": true
  },
  "include": ["main.ts", "src/**/*.ts", "e2e/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
