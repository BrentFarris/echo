{
  "name": "echo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "vitest run --config vitest.config.mjs --configLoader native",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/virtual-core": "3.17.7",
    "@vscode/codicons": "0.0.46-24",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "marked": "14.0.0",
    "monaco-editor": "0.56.0",
    "vscode-languageserver-protocol": "3.17.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
